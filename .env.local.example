# HubSpot Private App Token (선택 사항)
# HubSpot 포털 → 설정 → 통합 → Private Apps에서 발급
# 필요 권한: crm.objects.quotes.write, crm.objects.line_items.write
HUBSPOT_API_KEY=pat-na1-your-token-here

# 공유 비밀번호 (선택 사항)
# 설정하면 사이트 전체가 Basic Auth로 보호됨 (Modusign 팀원에게만 이 비밀번호 공유)
# 설정하지 않으면 보호 없이 누구나 접근 가능
APP_PASSWORD=
